[Unit]
Description=HawksTrade HawksCapitol signal refresh
Documentation=file:/home/ec2-user/HawksTrade/scheduler/systemd/README.md
Wants=network-online.target
After=network-online.target hawkstrade-secrets.service
Requires=hawkstrade-secrets.service

[Service]
Type=oneshot
User=ec2-user
Group=ec2-user
WorkingDirectory=/home/ec2-user/HawksTrade
EnvironmentFile=/etc/hawkstrade/hawkstrade.env
Environment=HAWKSTRADE_REQUIRE_SHM=1
Environment=HAWKSTRADE_CAPITOL_DIR=/home/ec2-user/HawksTrade/integrations/HawksCapitol
Environment=HAWKSTRADE_CAPITOL_SIGNAL_PATH=/home/ec2-user/HawksTrade/integrations/HawksCapitol/data/signals/latest.json
ExecStart=/home/ec2-user/HawksTrade/scripts/run_hawkscapitol_refresh.sh
Restart=no
TimeoutStartSec=45min
StandardOutput=journal
StandardError=journal
