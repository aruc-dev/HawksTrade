# Copy to /etc/hawkstrade/hawkstrade.env and edit for the host.
# Keep this file mode 0600 after editing.

HAWKSTRADE_DIR=/home/ec2-user/HawksTrade
HAWKSTRADE_USER=ec2-user
HAWKSTRADE_GROUP=ec2-user

# The secrets service copies this file into /dev/shm before scheduled jobs run.
HAWKSTRADE_SECRET_SOURCE=/etc/hawkstrade/hawkstrade.secrets
HAWKSTRADE_SHM_SECRET_FILE=/dev/shm/.hawkstrade.env

# Fail closed on production Linux if /dev/shm secrets are missing or stale.
HAWKSTRADE_REQUIRE_SHM=1
HAWKSTRADE_SHM_MAX_AGE_SECONDS=86400
# Required only when config resolves to mode: live. Leave unset for paper mode.
# HAWKSTRADE_LIVE_ACK=I_UNDERSTAND_REAL_MONEY

# Runtime controls.
HAWKSTRADE_LOCK_TIMEOUT_SECONDS=600
HAWKSTRADE_HEALTH_HOURS=4
HAWKSTRADE_HEALTH_SNAPSHOT_RETENTION_DAYS=14
# HAWKSTRADE_HEALTH_ALERT_WEBHOOK_URL=

# Required before enabling hawkstrade-capitol-refresh.timer in production.
# This command must refresh HAWKSTRADE_CAPITOL_SIGNAL_PATH from real
# HawksCapitol source data and exit nonzero on failure. The built-in demo
# HawksCapitol sample-data export is blocked unless
# HAWKSTRADE_CAPITOL_ALLOW_SAMPLE_DATA=1 is set for a non-production test.
# HAWKSTRADE_CAPITOL_REFRESH_COMMAND=
